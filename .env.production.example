# ==============================================================================
# shared-finance-app - PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# ==============================================================================
# ISTRUZIONI:
# 1. Copia questo file in .env.production: cp .env.production.example .env.production
# 2. Genera segreti crittografici sicuri con il comando:
#    openssl rand -hex 32
# 3. Non committare MAI il file .env.production reale nel repository git!
# ==============================================================================

# General Configuration
ENVIRONMENT=production
PROJECT_NAME="shared-finance-app"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Domain & CORS (Sostituisci con il tuo dominio reale HTTPS)
BACKEND_CORS_ORIGINS=["https://app.tuodominio.com", "https://tuodominio.com"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=shared_admin
POSTGRES_PASSWORD=GENERATE_SECURE_PASSWORD_HERE_WITH_OPENSSL
POSTGRES_DB=shared_finance_prod

# Redis Cache & Asynchronous Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=GENERATE_REDIS_PASSWORD_HERE_WITH_OPENSSL

# Storage & Pre-signed URLs Configuration
STORAGE_PROVIDER=local  # oppure "s3" per AWS S3 / MinIO
STORAGE_LOCAL_DIR=uploads/receipts
STORAGE_SIGNING_SECRET=GENERATE_HMAC_SECRET_HERE_WITH_OPENSSL_RAND_HEX_32
PRESIGNED_URL_EXPIRATION_SECONDS=900

# AWS S3 Configuration (Se STORAGE_PROVIDER=s3)
S3_BUCKET_NAME=shared-finance-receipts-prod
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# OpenAI Vision AI Configuration
OPENAI_API_KEY=sk-proj-YOUR_ACTUAL_OPENAI_API_KEY_HERE
VISION_MODEL=gpt-4o-mini
